{
  "name": "ayursutra-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd ayursutra-backend && npm run dev",
    "dev:frontend": "cd ayursutra-react && npm run dev",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start:backend\" \"npm run dev:frontend\"",
    "start:backend": "cd ayursutra-backend && npm start",
    "build": "cd ayursutra-react && npm run build",
    "seed": "cd ayursutra-backend && node seedData.js"
  },
  "dependencies": {
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
